# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# MOT Reminder Management System Backend
# ==============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual production values.
# DO NOT COMMIT .env TO GIT!

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB)
# If using a MongoDB container or external cluster (e.g. MongoDB Atlas):
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/multi-mot-database?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/multi-mot-database

# Security & Authentication
# Generate a strong 64-character secret using: openssl rand -base64 32
JWT_SECRET=replace_with_a_very_strong_random_secret_string_for_production

# Mail / SMTP Configuration (Hostinger / Custom SMTP)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@ondoorcarservice.com
MAIL_PASSWORD=your_secure_smtp_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_NAME=OnDoor Car Service MOT Reminders
MAIL_FROM_ADDRESS=noreply@ondoorcarservice.com
SUPER_ADMIN_EMAIL=admin@ondoorcarservice.com

# DVSA MOT History API Configuration (DVLA / DVSA OAuth2 API)
DVSA_CLIENT_ID=your_dvsa_client_id
DVSA_CLIENT_SECRET=your_dvsa_client_secret
DVSA_API_KEY=your_dvsa_api_key
DVSA_SCOPE=https://tapi.dvsa.gov.uk/.default
DVSA_TOKEN_URL=https://login.microsoftonline.com/a455b827-244f-4c97-b5b4-ce5d13b4d00c/oauth2/v2.0/token

# Twilio SMS Configuration (Optional / If enabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
